{
  "name": "mcp-server-docker-generator",
  "version": "0.1.0",
  "description": "Tool to generate MCP server Docker containers from OpenAPI 3.1.1 swagger.yml files",
  "main": "src/cli/generate.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "tsc && find dist/tests -name '*.test.js' | xargs node --test",
    "lint": "eslint --ext .ts src/ tests/",
  "dev": "rm -rf dist && npm run build && node dist/src/cli/generate.js openapi.yaml"
  },
  "keywords": [
    "openapi",
    "swagger",
    "docker",
    "mcp",
    "generator"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dockerode": "^3.3.0",
    "openapi-types": "^12.0.1",
    "ts-node": "^10.9.2",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.43",
    "@types/node": "^24.3.3",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
